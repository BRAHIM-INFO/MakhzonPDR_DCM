<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MakhzonPDR_DCM.MainPage">

    <Grid RowDefinitions="Auto, *, Auto">

        <!-- Header Section -->
        <Grid Grid.Row="0" Padding="20,15" ColumnDefinitions="*, Auto">
            <VerticalStackLayout Grid.Column="0">
                <Label Text="Dashboard" FontSize="30" FontAttributes="Bold" TextColor="Black"/>
                <Label Text="Bienvenue, Admin" TextColor="Gray" FontSize="14"/>
            </VerticalStackLayout>
            <!-- صورة المستخدم (رمز نصي دائري) -->
            <Frame Grid.Column="1" HeightRequest="50" WidthRequest="50" CornerRadius="25" Padding="0" BackgroundColor="#A5061E" BorderColor="Transparent">
                <Label Text="👤" HorizontalOptions="Center" VerticalOptions="Center" TextColor="White" FontSize="25"/>
            </Frame>
        </Grid>

        <ScrollView Grid.Row="1" Padding="20,0">
            <!-- قسم الإحصائيات المطور -->
            <VerticalStackLayout Spacing="15" Padding="0,10">

                <!-- بطاقة إجمالي المخزون (الكبيرة) -->
                <Frame BackgroundColor="#A5061E" CornerRadius="20" HasShadow="True" Padding="20" BorderColor="Transparent">
                    <Grid ColumnDefinitions="*, Auto">
                        <VerticalStackLayout Grid.Column="0" Spacing="5">
                            <Label Text="STOCK TOTAL" TextColor="#FFCCCC" FontSize="12" FontAttributes="Bold"/>
                            <Grid ColumnDefinitions="*, Auto">
                                <Label x:Name="TotalStockLabel" Text="0" TextColor="White" FontSize="36" FontAttributes="Bold"/>
                                <Label Grid.Column="1" Text="📊" FontSize="30"/>
                            </Grid>
                            <Label Text="Articles en base de données" TextColor="White" FontSize="11" Opacity="0.8"/>
                        </VerticalStackLayout>
                        <Image Grid.Column="1" Source="inventory_icon.png" HeightRequest="60" VerticalOptions="Center"/>
                        <Grid ColumnDefinitions="*, Auto">
                            <Label Grid.Column="1" Text="↑ 4.5%" TextColor="#80FF80" FontAttributes="Bold"/>
                        </Grid>
                    </Grid>
                </Frame>

                <!-- صف يحتوي على بطاقتين صغيرتين -->
                <Grid ColumnDefinitions="*, *" ColumnSpacing="15">

                    <!-- بطاقة التعديلات (باللون البرتقالي) -->
                    <Frame Grid.Column="0" BackgroundColor="#F5A623" CornerRadius="20" Padding="15" BorderColor="Transparent">
                        <VerticalStackLayout Spacing="5">
                            <Label Text="MODIFIÉS" TextColor="White" FontSize="11" FontAttributes="Bold"/>
                            <Label x:Name="UpdatedStockLabel" Text="0" TextColor="White" FontSize="24" FontAttributes="Bold"/>
                            <Label Text="Mises à jour" TextColor="White" FontSize="10" Opacity="0.9"/>
                        </VerticalStackLayout>
                    </Frame>

                    <!-- بطاقة المنتجات الجديدة (باللون الأزرق/الأخضر) -->
                    <Frame Grid.Column="1" BackgroundColor="#4A90E2" CornerRadius="20" Padding="15" BorderColor="Transparent">
                        <VerticalStackLayout Spacing="5">
                            <Label Text="NOUVEAUX" TextColor="White" FontSize="11" FontAttributes="Bold"/>
                            <Label x:Name="NewProductsLabel" Text="0" TextColor="White" FontSize="24" FontAttributes="Bold"/>
                            <Label Text="Produits machines" TextColor="White" FontSize="10" Opacity="0.9"/>
                        </VerticalStackLayout>
                    </Frame>
                </Grid>

                <Label Text="CATEGORIES" TextColor="#888" FontAttributes="Bold" FontSize="12"/>
                <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
                    <HorizontalStackLayout Spacing="15" Padding="0,5,0,20">
                        <VerticalStackLayout Spacing="8">
                            <Frame BackgroundColor="#4A90E2" WidthRequest="70" HeightRequest="70" CornerRadius="20" BorderColor="Transparent" Padding="0">
                                <Label Text="⚙️" HorizontalOptions="Center" VerticalOptions="Center" FontSize="25"/>
                            </Frame>
                            <Label Text="Pièces" HorizontalOptions="Center" FontSize="12"/>
                        </VerticalStackLayout>
                        <VerticalStackLayout Spacing="8">
                            <Frame BackgroundColor="#50E3C2" WidthRequest="70" HeightRequest="70" CornerRadius="20" BorderColor="Transparent" Padding="0">
                                <Label Text="🛢️" HorizontalOptions="Center" VerticalOptions="Center" FontSize="25"/>
                            </Frame>
                            <Label Text="Lubrifiant" HorizontalOptions="Center" FontSize="12"/>
                        </VerticalStackLayout>
                        <VerticalStackLayout Spacing="8">
                            <Frame BackgroundColor="#F5A623" WidthRequest="70" HeightRequest="70" CornerRadius="20" BorderColor="Transparent" Padding="0">
                                <Label Text="🛠️" HorizontalOptions="Center" VerticalOptions="Center" FontSize="25"/>
                            </Frame>
                            <Label Text="Pneumatique" HorizontalOptions="Center" FontSize="12"/>
                        </VerticalStackLayout>
                        <VerticalStackLayout Spacing="8">
                            <Frame BackgroundColor="#EB5757" WidthRequest="70" HeightRequest="70" CornerRadius="20" BorderColor="Transparent" Padding="0">
                                <Label Text="📂" HorizontalOptions="Center" VerticalOptions="Center" FontSize="25"/>
                            </Frame>
                            <Label Text="Docs" HorizontalOptions="Center" FontSize="12"/>
                        </VerticalStackLayout>
                    </HorizontalStackLayout>
                </ScrollView>
            </VerticalStackLayout>
        </ScrollView>

        <!-- Bottom Navigation with FAB -->
        <!-- الجزء السفلي المطور في MainPage.xaml -->
        <Grid Grid.Row="2" HeightRequest="70" BackgroundColor="White" VerticalOptions="End">
            <Grid ColumnDefinitions="*, *, *, *" Padding="10">

                <!-- زر الرئيسية (🏠) -->
                <VerticalStackLayout Grid.Column="0" VerticalOptions="Center">
                    <Label Text="🏠" FontSize="25" HorizontalOptions="Center">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="GoToHome" />
                        </Label.GestureRecognizers>
                    </Label>
                    <Label Text="Home" FontSize="10" HorizontalOptions="Center" TextColor="#A5061E"/>
                </VerticalStackLayout>

                <!-- زر المخزون (📦) -->
                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                    <Label Text="📦" FontSize="25" HorizontalOptions="Center" Opacity="0.5">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="GoToStock" />
                        </Label.GestureRecognizers>
                    </Label>
                    <Label Text="Stock" FontSize="10" HorizontalOptions="Center" TextColor="Gray"/>
                </VerticalStackLayout>

                
                
                <!-- زر المستخدمين (👥) -->
                <VerticalStackLayout Grid.Column="2" VerticalOptions="Center" Margin="30,0,0,0">
                    <Label Text="👥" FontSize="25" HorizontalOptions="Center" Opacity="0.5">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="GoToUsers" />
                        </Label.GestureRecognizers>
                    </Label>
                    <Label Text="Users" FontSize="10" HorizontalOptions="Center" TextColor="Gray"/>
                </VerticalStackLayout>

                <!-- زر التنبيهات (🔔) -->
                <VerticalStackLayout Grid.Column="3" VerticalOptions="Center">
                    <Label Text="🔔" FontSize="25" HorizontalOptions="Center" Opacity="0.5">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer  />
                        </Label.GestureRecognizers>
                    </Label>
                    <Label Text="Alerts" FontSize="10" HorizontalOptions="Center" TextColor="Gray"/>
                </VerticalStackLayout>
            </Grid>

            <!-- الزر العائم المركزي (+) لإضافة منتج جديد -->
            <Button Text="+" FontSize="30" BackgroundColor="#A5061E" TextColor="White" 
         HeightRequest="60" WidthRequest="60" CornerRadius="30" 
         VerticalOptions="Start" HorizontalOptions="Center" Margin="0,-35,0,0"
         Clicked="OnAddProductClicked"
         Shadow="{Shadow Brush=Black, Offset='0,5', Radius=10, Opacity=0.2}"/>
        </Grid>
    </Grid>

</ContentPage>
