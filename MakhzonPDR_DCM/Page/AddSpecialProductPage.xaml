<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MakhzonPDR_DCM.Page.AddSpecialProductPage"
             Title="Nouvel Article" BackgroundColor="White">

    <ScrollView>
        <VerticalStackLayout Padding="25" Spacing="20">
            <Label Text="Détails du Produit" FontSize="22" FontAttributes="Bold" TextColor="#A5061E"/>

            <Entry x:Name="RefEntry" Placeholder="Référence" BackgroundColor="#F9F9F9" HeightRequest="50"/>
            <Entry x:Name="NameEntry" Placeholder="Désignation de l'article" BackgroundColor="#F9F9F9" HeightRequest="50"/>
            <Entry x:Name="MachineEntry" Placeholder="Nom de la Machine" BackgroundColor="#F9F9F9" HeightRequest="50"/>
            <Entry x:Name="QteEntry" Placeholder="Quantité" Keyboard="Numeric" BackgroundColor="#F9F9F9" HeightRequest="50"/>
            <Entry x:Name="CasierEntry" Placeholder="Emplacement (Casier)" BackgroundColor="#F9F9F9" HeightRequest="50"/>

            <Button Text="ENREGISTRER" Clicked="OnSaveClicked" 
            BackgroundColor="#A5061E" TextColor="White" 
            FontAttributes="Bold" HeightRequest="55" CornerRadius="10" Margin="0,20,0,0"/>

            <ActivityIndicator x:Name="loader" IsRunning="False" Color="#A5061E"/>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>