<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MakhzonPDR_DCM.Page.LoginPage"
             Title="LoginPage">
    <ScrollView>
        <VerticalStackLayout Padding="30" Spacing="25" VerticalOptions="Center">

            <Label Text="COSIDER TP" 
                TextColor="#1A2B4C" 
                FontSize="28" 
                FontAttributes="Bold" 
                HorizontalOptions="Center" />



            <Image Source="cosider_logo.png" 
                HeightRequest="80" 
                HorizontalOptions="Center" 
                Margin="0,0,0,30"/>

            <!-- حقل البريد الإلكتروني -->
            <VerticalStackLayout Spacing="5">
                <Label Text="EMAIL" FontSize="12" TextColor="#1A2B4C" FontAttributes="Bold" />
                <Grid ColumnDefinitions="30, *">
                    <Image Source="email_icon.png" Grid.Column="0" WidthRequest="20" VerticalOptions="Center"/>
                    <Entry x:Name="EmailEntry" Grid.Column="1" Placeholder="name@adresseemail.com" Keyboard="Email" BackgroundColor="Transparent" />
                </Grid>
                <BoxView HeightRequest="1" Color="#1A2B4C" />
            </VerticalStackLayout>

            <!-- حقل كلمة المرور -->
            <VerticalStackLayout Spacing="5">
                <Label Text="PASSWORD" FontSize="12" TextColor="#1A2B4C" FontAttributes="Bold" />
                <Grid ColumnDefinitions="30, *">
                    <Image Source="lock_icon.png" Grid.Column="0" WidthRequest="20" VerticalOptions="Center"/>
                    <Entry x:Name="PasswordEntry" Grid.Column="1" IsPassword="True" Placeholder="••••••••" BackgroundColor="Transparent" />
                </Grid>
                <BoxView HeightRequest="1" Color="#1A2B4C" />
            </VerticalStackLayout>

            <Label Text="Forgot password?" 
                TextColor="#1A2B4C" 
                FontSize="14" 
                HorizontalOptions="Center" />

            <!-- زر الدخول -->
            <Button Text="LOG IN" 
                 Clicked="OnPerformLoginClicked"
                 BackgroundColor="#B31F24" 
                 TextColor="White" 
                 HeightRequest="55" 
                 CornerRadius="27" 
                 FontAttributes="Bold"
                 Margin="0,20,0,0"/>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>